# Runs the full `npm test` suite (node --test, no browser) on a throwaway box: `testbox run`.
# See ~/Documents/GitHub/bash_commands/testbox/README.md.
TESTBOX_REPO=clay-agent
# npmrelease runs this box instead of the local suite, and publishes with --ignore-scripts.
TESTBOX_RELEASE=1
TESTBOX_SETUP='npm ci --no-audit --no-fund'
# The lanes of `npm test`, each reported in test-box-out/<run>/release-checks.json, which
# hypersave's release lane requires when TESTBOX_RELEASE=1 (scripts/release-checks.mjs).
TESTBOX_COMMAND='node scripts/release-checks.mjs --script test --gate-first'
TESTBOX_TIMEOUT=${TESTBOX_TIMEOUT:-20m}
