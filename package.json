{
  "name": "@panphora/claycli",
  "version": "0.8.1",
  "description": "Let AI agents read and edit HTML files on hyperclay.com from the command line or as an MCP server",
  "type": "module",
  "bin": {
    "claycli": "bin/claycli.js"
  },
  "exports": {
    ".": "./src/cli.js",
    "./hosted": "./src/hosted.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "deploy": "node scripts/publish-old-name.mjs && wrangler deploy && git rev-parse HEAD > .deploy"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hyperclay",
    "html-clay",
    "malleable-html",
    "ai-agent"
  ],
  "author": "David Miranda",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperspacesystems/claycli.git"
  },
  "homepage": "https://claycli.com",
  "bugs": {
    "url": "https://github.com/hyperspacesystems/claycli/issues"
  },
  "hyper": {
    "kind": "cli",
    "status": "active",
    "url": "https://claycli.com"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cheerio": "1.2.0",
    "zod": "4.6.7"
  }
}
